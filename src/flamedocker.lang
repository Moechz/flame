# ===========================================================================
# Multilingual file for the TOS 7 Docker application "flamedocker".
# File name MUST be: <appid>.lang.  23-language superset (14 required by TOS).
# The App Center picks the text matching the user's device language;
# untranslated nodes fall back to English, which the official guide allows.
# Fields: name (app title), auth (upstream author), descript (up to 512
# chars), release_note, important (up to 512 chars).
# Translations come from tosapp.json "translations"; run
#   tosdocker lang <app>          to re-render this file
#   tosdocker translate <app>     to see what still needs translating
# ===========================================================================
[en-us]
name         = "Flame"
auth         = "pawelmalak"
version      = "@@VERSION@@"
descript     = "Flame is a self-hosted start page and dashboard. Add links to all your services, group them into sections, and get weather, a search bar and bookmarks on one clean page. Configuration lives in a few files in the application data folder, so the layout survives restarts and is easy to back up."
release_note = "1. Review remediation. The package now uses the upstream multi-architecture image build (amd64, arm64, armv7), so aarch64 installations start instead of failing with an exec format error. 2. The default password baked into the image is no longer used: a random administrator password is generated on first start and kept in the application data folder. 3. Added PRIVACY.md (stored data, third-party endpoints, retention, user rights), NOTICE.md and a complete README with repository layout, build steps and uninstall instructions. 4. Upstream 2.4.0 is the latest release. The open CVE findings sit in the Node dependencies bundled inside the upstream image, which this package cannot patch without rebuilding that image. The image is retained and NOTICE.md documents the tracking and follow-up plan."
important    = "Requires DockerEngine (installed automatically if missing). The administrator password is generated on first start and stored in DockerAppData/flamedocker/data/admin-credentials.txt, so read it on the NAS before signing in. Weather is optional and needs a WeatherAPI.com key in the config. Plain HTTP on port 8027 - put a TLS reverse proxy in front of it before exposing it to the internet."

[zh-cn]
name         = "Flame"
auth         = "pawelmalak"
version      = "@@VERSION@@"
descript     = "Flame 是自建的导航首页与仪表盘。把常用服务链接分类放进分区，配上天气、搜索框和书签，一页就能看到所有内容。配置就是应用数据目录里的几个文件，重启不丢、备份也简单。"
release_note = "1. 按审核意见整改。2. 改用上游多架构镜像（amd64、arm64、armv7），aarch64 安装后不再因 exec format error 启动失败。3. 不再使用镜像内置的默认口令，首次启动随机生成管理员密码并保存在应用数据目录。4. 新增 PRIVACY.md（数据、第三方端点、保留期、用户权利）与 NOTICE.md，补全 README（目录结构、构建、数据与卸载）。5. 上游 2.4.0 已是最新版本，CVE 出在其内置 Node 依赖中，本包无法在不重建该镜像的前提下修补，镜像保留并在 CHANGELOG 与 NOTICE 中说明跟进计划。"
important    = "需要 DockerEngine（缺失时应用中心会自动安装）。管理员密码在首次启动时随机生成并保存在 DockerAppData/flamedocker/data/admin-credentials.txt，登录前请先在 NAS 上查看。天气为可选功能，需要在配置中填入 WeatherAPI.com 的 Key。界面为纯 HTTP（8027 端口），暴露到公网前请配置带 TLS 的反向代理。"

[zh-hk]
name         = "Flame"
auth         = "pawelmalak"
version      = "@@VERSION@@"
descript     = "Flame 是自建的導航首頁與儀表盤。把常用服務連結分類放進分區，配上天氣、搜尋框和書籤，一頁就能看到所有內容。設定就是應用資料目錄裡的幾個檔案，重啟不丟、備份也簡單。"
release_note = "1. 按審核意見整改。2. 改用上游多架構鏡像（amd64、arm64、armv7），aarch64 安裝後不再因 exec format error 啟動失敗。3. 不再使用鏡像內建的預設口令，首次啟動隨機產生管理員密碼並保存在應用資料目錄。4. 新增 PRIVACY.md（資料、第三方端點、保留期、使用者權利）與 NOTICE.md，補全 README（目錄結構、建置、資料與卸載）。5. 上游 2.4.0 已是最新版本，CVE 出在其內建 Node 依賴中，本包無法在不重建該鏡像的前提下修補，鏡像保留並在 CHANGELOG 與 NOTICE 中說明跟進計畫。"
important    = "需要 DockerEngine（缺少時應用中心會自動安裝）。管理員密碼在首次啟動時隨機產生並保存在 DockerAppData/flamedocker/data/admin-credentials.txt，登入前請先在 NAS 上查看。天氣為可選功能，需要在設定中填入 WeatherAPI.com 的 Key。介面為純 HTTP（8027 埠），公開到互聯網前請配置帶 TLS 的反向代理。"

